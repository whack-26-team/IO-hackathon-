# Copy this file to server/.env and fill it in. NEVER commit server/.env.
# The team OpenAI API key (Ahmed creates it at platform.openai.com, NOT a ChatGPT subscription).
OPENAI_API_KEY=

# ElevenLabs voice (Ahmed's chosen route, issue #13). From Ahmed, privately. Never commit these.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Only needed if we use OpenAI's realtime voice. Confirm the model name in OpenAI's docs.
OPENAI_REALTIME_MODEL=gpt-realtime
REMY_VOICE=marin
SESSION_MINUTES=10

# Used by tools/import_recipe.py. "1" is TheMealDB's free development key.
THEMEALDB_KEY=1
