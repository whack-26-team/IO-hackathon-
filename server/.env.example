# Copy this file to server/.env and fill it in. NEVER commit server/.env.
# The team OpenAI API key (Ahmed creates it at platform.openai.com, NOT a ChatGPT subscription).
OPENAI_API_KEY=

# Confirm the current realtime model name in OpenAI's docs.
OPENAI_REALTIME_MODEL=gpt-realtime
REMY_VOICE=marin
SESSION_MINUTES=10

# Used by tools/import_recipe.py. "1" is TheMealDB's free development key.
THEMEALDB_KEY=1
